# Songbook environment variables. Copy to .env for local development.

# PostgreSQL connection string used by Prisma. `npm run db:up` starts a local
# container on port 5433 (5432 is left free for other local databases).
# In production use the pooled connection string from your provider (e.g. Neon).
DATABASE_URL="postgresql://songbook:songbook@localhost:5433/songbook"

# Better Auth: a long random secret (openssl rand -base64 32) and the public URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret for the demo-cleanup cron endpoint (/api/cron/cleanup-demo).
# Vercel sends it automatically as a Bearer token when CRON_SECRET is set.
CRON_SECRET=""
