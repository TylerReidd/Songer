# Songbook environment variables. Copy to .env for local development.

# PostgreSQL connection string used by Prisma. `npm run db:up` starts a local
# container on port 5433 (5432 is left free for other local databases).
# In production use the pooled connection string from your provider (e.g. Neon).
DATABASE_URL="postgresql://songbook:songbook@localhost:5433/songbook"

# Better Auth: a long random secret (openssl rand -base64 32) and the public URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Shared secret for the demo-cleanup cron endpoint (/api/cron/cleanup-demo).
# Vercel sends it automatically as a Bearer token when CRON_SECRET is set.
CRON_SECRET=""

# Outgoing email for account verification and password reset, over SMTP.
# Gmail works for free: turn on 2-step verification, create an App Password at
# https://myaccount.google.com/apppasswords, and use it as SMTP_PASS.
# Leave SMTP_USER/SMTP_PASS empty in development to print emails to the console
# instead of sending them. Production refuses to start sign-ups without them.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Optional "From" header; defaults to Songbook <SMTP_USER>.
EMAIL_FROM=""

# Shown on the privacy and terms pages as the way to reach you about data.
# Optional; without it the pages point at the source repository instead.
NEXT_PUBLIC_CONTACT_EMAIL=""
