# Songbook environment variables
# Copy to .env.local for development. None of these are needed in Phase 1
# (the app runs on in-memory sample data); they come into play in Phase 2.

# PostgreSQL connection string used by Prisma (pooled endpoint in production).
DATABASE_URL="postgresql://songbook:songbook@localhost:5432/songbook"

# Better Auth: a long random secret (openssl rand -base64 32) and the public URL.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
